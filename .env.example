# Ethereum RPC URL
NETWORK_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Wallet private key (without 0x prefix)
WALLET_PRIVATE_KEY=your_private_key_here

# Contract addresses
PROTOCOL_CORE_ADDRESS=0x1234567890123456789012345678901234567890
CONSENSUS_ADDRESS=0x0987654321098765432109876543210987654321
DXP_TOKEN_ADDRESS=0x4ed7c70F96B99c776995fB64377f0d4aB3B0e1C1

# Gas settings (optional)
GAS_PRICE_MULTIPLIER=2.0
GAS_LIMIT=500000
